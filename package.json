{
  "name": "beside-pet-backend",
  "version": "0.1.0",
  "description": "Pet-loss emotional support agent API (NestJS, DDD, Claude)",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:prod": "NODE_ENV=production nest start",
    "build": "nest build",
    "lint": "biome check .",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "guard": "pdks explain && node dev-tools/docs.mjs check",
    "docs:search": "node dev-tools/docs.mjs search",
    "docs:list": "node dev-tools/docs.mjs list",
    "docs:show": "node dev-tools/docs.mjs show",
    "docs:index": "node dev-tools/docs.mjs index",
    "docs:check": "node dev-tools/docs.mjs check",
    "postinstall": "lefthook install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@nestjs/cli": "^10.4.0",
    "@polydeukes/adapter-claude-code": "0.9.0",
    "@polydeukes/adapter-codex": "0.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.14.0",
    "lefthook": "2.1.3",
    "polydeukes": "0.9.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "@nestjs/core"
    ]
  }
}
