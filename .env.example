# Committed template. Put real values in the two files below; both are gitignored:
#   .env.development  → local development (loaded by `pnpm start:dev`, NODE_ENV=development)
#   .env              → production/portfolio (default load for `pnpm start`)
# In a real deployment, inject values via Secrets Manager/SSM instead of files.

# --- Claude (server-side only. NEVER expose to the frontend) ---
# Required. Without a key the server exits at boot with a clear error (live-only).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- LLM routing (optional): pick provider/model explicitly. Defaults to anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# --- Auth (JWT httpOnly cookie) ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=7d

# --- Admin account: never seeded via env. Create it through POST /v1/auth/setup with the
#     one-time setup token printed in the boot log (credentials never touch a file). ---

# --- PostgreSQL (required — the server refuses to boot without it) ---
# Local: `docker compose up -d db`
DATABASE_URL=postgres://beside:beside@localhost:5432/besidepet

# --- Server ---
PORT=3000
