# 이 파일은 커밋되는 템플릿이다. 실제 값은 아래 두 파일에 넣으며 둘 다 gitignore된다:
#   .env.development  → 개발용 (`pnpm start:dev`, NODE_ENV=development 가 로드)
#   .env              → 프로덕션/포트폴리오 (`pnpm start` 기본 로드)
# 실배포에선 값을 파일이 아니라 Secrets Manager/SSM으로 컨테이너에 주입하는 게 정석.

# --- Claude (서버사이드 전용. 절대 프론트엔드에 노출 금지) ---
# 필수. 키가 없으면 부팅 시점에 명확한 에러로 종료된다 (라이브 전용).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- LLM 라우팅(옵션): 프로바이더/모델 명시 선택. 미설정 시 anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5

# --- 인증 (JWT httpOnly 쿠키) ---
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=7d

# --- admin 계정: env로 시드하지 않는다. 최초 부팅 시 서버 로그에 출력되는 1회용 setup 토큰으로
#     POST /v1/auth/setup 에서 생성한다 (자격증명이 파일 어디에도 남지 않음). ---

# --- PostgreSQL + pgvector (이후 영속화 단계에서 사용. 초기에는 인메모리) ---
DATABASE_URL=postgres://beside:beside@localhost:5432/besidepet

# --- 서버 ---
PORT=3000
